# Next.js Frontend
NEXT_PUBLIC_GOOGLE_API_KEY=""
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="development"
NEXT_PUBLIC_GOOGLE_MAPS_ID=""

# Only needed for `npm run db:start:neon` (the `neon` compose profile).
# The default local database (`npm run db:start`) is a plain Postgres container.
PARENT_BRANCH_ID=""
NEON_PROJECT_ID=""
NEON_API_KEY=""

# Connection string for database
DATABASE_URL=postgres://neon:npg@localhost:5432/neondb

# Sanity Studio
SANITY_STUDIO_API_VERSION=2024-03-09
SANITY_STUDIO_PROJECT_ID=""
SANITY_STUDIO_DATASET="development"
SANITY_STUDIO_ORGANIZATION_ID=""
SANITY_STUDIO_GOOGLE_API_KEY=""
SANITY_STUDIO_GOOGLE_MAPS_ID=""

# Sanity Apps
SANITY_APP_API_VERSION=2024-03-09
SANITY_APP_DATASET="development"
SANITY_APP_PROJECT_ID=""
SANITY_APP_ORGANIZATION_ID=""
SANITY_APP_PROVIDER_AGENT_API_URL=http://localhost:4011
SANITY_APP_STUDIO_URL=http://localhost:3333/studio

# packages/api
API_PORT=4011
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3334
# Signs the API's own session tokens. Generate with `openssl rand -base64 32`.
API_SESSION_SECRET=""
# The Sanity project a caller must belong to. A request is accepted only if the
# user holds `sanity.document.filter.mode` on this project.
SANITY_PROJECT_ID=""

# AI Agent
OPENAI_API_KEY=""
FIRECRAWL_API_KEY=""
SANITY_API_TOKEN=""
SANITY_DATASET="development"
LMNR_PROJECT_API_KEY=""
